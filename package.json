{
  "name": "tsukai",
  "version": "0.1.0",
  "description": "AgentRun lifecycle and observation SDK with Pi RPC integration",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.27.0",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "bin": {
    "tsukai": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:domain": "vitest run test/domain test/application --passWithNoTests",
    "test:observation": "vitest run test/observation --passWithNoTests",
    "test:mock": "vitest run test/mock test/testing --passWithNoTests",
    "test:pi": "vitest run test/pi --passWithNoTests",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "verify": "pnpm run format:check && pnpm run build && pnpm run typecheck && pnpm run test",
    "test:package": "node scripts/test-package.mjs",
    "certify:pi": "pnpm run build && node scripts/certify-pi.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
